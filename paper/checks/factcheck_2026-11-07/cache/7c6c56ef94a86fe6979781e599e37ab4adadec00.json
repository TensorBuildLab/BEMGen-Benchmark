614000}, "score": 44.712437, "resource": {"primary": {"URL": "http://www.proceedings.com/085713-5547.html"}}, "issued": {"date-parts": [[2025]]}, "references-count": 0, "URL": "https://doi.org/10.52202/085713-5547", "published": {"date-parts": [[2025]]}}, {"indexed": {"date-parts": [[2025, 7, 3]], "date-time": "2025-07-03T09:46:00Z", "timestamp": 1751535960122, "version": "3.40.5"}, "reference-count": 0, "publisher": "Ithaka S+R", "content-domain": {"domain": [], "crossmark-restriction": false}, "DOI": "10.18665/sr.313288", "type": "report", "created": {"date-parts": [[2020, 5, 26]], "date-time": "2020-05-26T21:50:25Z", "timestamp": 1590529825000}, "source": "Crossref", "is-referenced-by-count": 3, "title": ["Preprints int he Spotlight: Establishing Best Practices, Building Trust"], "prefix": "10.18665", "author": [{"ORCID": "https://orcid.org/0000-0001-6175-5157", "authenticated-orcid": false, "given": "Oya", "family": "Rieger", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "7944", "published-online": {"date-parts": [[2020, 5, 27]]}, "deposited": {"date-parts": [[2020, 5, 26]], "date-time": "2020-05-26T21:50:25Z", "timestamp": 1590529825000}, "score": 35.785, "resource": {"primary": {"URL": "http://sr.ithaka.org/?p=313288"}}, "issued": {"date-parts": [[2020, 5, 27]]}, "references-count": 0, "URL": "https://doi.org/10.18665/sr.313288", "published": {"date-parts": [[2020, 5, 27]]}}, {"institution": [{"name": "American Psychological Association", "acronym": ["APA"]}], "indexed": {"date-parts": [[2024, 2, 14]], "date-time": "2024-02-14T00:15:07Z", "timestamp": 1707869707807}, "reference-count": 0, "publisher": "American Psychological Association (APA)", "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2007]]}, "DOI": "10.1037/e678382007-001", "type": "dataset", "created": {"date-parts": [[2013, 2, 20]], "date-time": "2013-02-20T20:26:50Z", "timestamp": 1361392010000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Building Community Capacity: Establishing Consensus on Best Practices"], "prefix": "10.1037", "author": [{"given": "Brett J.", "family": "Loftis", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "15", "container-title": ["PsycEXTRA Dataset"], "deposited": {"date-parts": [[2024, 2, 13]], "date-time": "2024-02-13T16:57:09Z", "timestamp": 1707843429000}, "score": 34.644802, "resource": {"primary": {"URL": "https://doi.apa.org/doi/10.1037/e678382007-001"}}, "issued": {"date-parts": [[2007]]}, "references-count": 0, "alternative-id": ["678382007-001"], "URL": "https://doi.org/10.1037/e678382007-001", "published": {"date-parts": [[2007]]}}, {"indexed": {"date-parts": [[2025, 9, 2]], "date-time": "2025-09-02T20:10:11Z", "timestamp": 1756843811026, "version": "3.44.0"}, "posted": {"date-parts": [[2025, 8, 25]]}, "group-title": "JMIR Perioperative Medicine", "reference-count": 13, "publisher": "JMIR Publications Inc.", "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<sec>\n                    <title>BACKGROUND</title>\n                        <p>Surgical education has shifted from the traditional Halsteadian apprenticeship model toward incorporating simulation due to work hour restrictions, increasing case complexity, and economic and liability pressures. Building on the success of the Fundamentals of Laparoscopic Surgery in general surgery, the Fundamentals of Arthroscopic Surgery Training (FAST) program was developed to establish proficiency benchmarks for orthopedic trainees in basic arthroscopic skills.</p>\n                </sec>\n                                <sec>\n                    <title>OBJECTIVE</title>\n                        <p>Establish benchmarks for five Fundamentals of Arthroscopy Surgery Training (FAST) workstation modules.</p>\n                </sec>\n                                <sec>\n                    <title>METHODS</title>\n                        <p>Sports medicine fellowship trained faculty were given instructions on the modules, two minutes of practice time, and then performed each task three times with both their dominant and nondominant hand. For each module, mean faculty performance was used to establish an efficiency benchmark (time) and precision benchmark (errors).</p>\n                </sec>\n                                <sec>\n                    <title>RESULTS</title>\n                        <p>The Probing module should be completed in less than 95 seconds with no errors. The Ring Transfer module should be completed in less than 134 seconds with no more than 1 error. The Maze module should be completed in less than 99 seconds with no errors. The Meniscectomy module should be completed in less than 68 seconds with no more than 1 error. Lastly, the Suture Passing module should be completed in less than 195 seconds with no more than 1 error.</p>\n                </sec>\n                                <sec>\n                    <title>CONCLUSIONS</title>\n                        <p>The FAST workstation can be utilized as a proficiency-based learning tool for residents to safely and effectively develop arthroscopic skills outside of the OR. These benchmarks were established via a method previously validated in surgical simulation and balance precision and efficiency for skills that are felt to be generalizable and transferable to arthroscopic surgeries.</p>\n                </sec>", "DOI": "10.2196/preprints.82723", "type": "posted-content", "created": {"date-parts": [[2025, 9, 2]], "date-time": "2025-09-02T19:40:07Z", "timestamp": 1756842007000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Establishing Benchmarks for the Fundamentals of Arthroscopy Surgery Training (FAST) Program (Preprint)"], "prefix": "10.2196", "author": [{"given": "Brianna", "family": "Caraet", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Eric", "family": "Davis", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Robert", "family": "Pedowitz", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Gregg", "family": "Nicandri", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "1010", "reference": [{"key": "ref1", "doi-asserted-by": "publisher", "DOI": "10.5435/jaaos-20-07-407"}, {"key": "ref2", "doi-asserted-by": "publisher", "DOI": "10.1016/s0002-9610(98)00080-4"}, {"key": "ref3", "doi-asserted-by": "publisher", "DOI": "10.1007/s00464-007-9451-1"}, {"key": "ref5", "doi-asserted-by": "publisher", "DOI": "10.1016/s1072-7515(00)00339-2"}, {"key": "ref6", "doi-asserted-by": "publisher", "DOI": "10.1097/00000658-200210000-00008"}, {"key": "ref7", "doi-asserted-by": "publisher", "DOI": "10.1007/s00464-001-9184-5"}, {"key": "ref8", "doi-asserted-by": "publisher", "DOI": "10.1016/j.jamcollsurg.2005.02.021"}, {"key": "ref9", "doi-asserted-by": "publisher", "DOI": "10.1016/j.amjsurg.2009.07.035"}, {"key": "ref10", "doi-asserted-by": "publisher", "DOI": "10.4135/9781412983907.n1596"}, {"key": "ref11", "doi-asserted-by": "publisher", "DOI": "10.5435/jaaos-20-07-410"}, {"key": "ref14", "doi-asserted-by": "publisher", "DOI": "10.1097/sla.0b013e31821263ec"}, {"key": "ref16", "doi-asserted-by": "publisher", "DOI": "10.1016/j.arthro.2015.06.021"}, {"key": "ref18", "doi-asserted-by": "publisher", "DOI": "10.1016/j.jsurg.2007.11.009"}], "deposited": {"date-parts": [[2025, 9, 2]], "date-time": "2025-09-02T19:40:08Z", "timestamp": 1756842008000}, "score": 33.191833, "resource": {"primary": {"URL": "http://preprints.jmir.org/preprint/82723"}}, "issued": {"date-parts": [[2025, 8, 25]]}, "references-count": 13, "URL": "https://doi.org/10.2196/preprints.82723", "published": {"date-